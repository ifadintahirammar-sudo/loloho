    background: #16834a;
    color: white;
}

.report-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.report-card {
    background: #f1faf4;
    border-bottom: 4px solid #16834a;
    border-radius: 10px;
